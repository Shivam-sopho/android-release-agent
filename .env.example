# Copy to .env (or export directly) and fill in. Never commit real values —
# this repo's scripts read these from the environment; nothing is written to
# disk in this repo by design.

# --- Model provider (used by scripts/setup-trueforge.mjs) ---
# One of: anthropic | openrouter
MODEL_PROVIDER=anthropic
# Provider API key. Never commit a real key.
API_KEY=
# Upstream model id. Defaults: claude-haiku-4-5-20251001 (anthropic),
# anthropic/claude-haiku-4.5 (openrouter). Override for a different model.
MODEL_ID=

# --- Service locations (defaults match a local setup, override if different) ---
TRUEFORGE_BASE=http://localhost:8790
MCP_SERVER_URL=http://127.0.0.1:8791/mcp
UI_BASE=http://127.0.0.1:8792

# --- Android SDK (needed by mcp-server's adb_* tools) ---
ANDROID_HOME=/root/Android/Sdk

# --- Only needed if your network drops outbound loopback/IPv6 oddly (see
# README "Setup" section for symptoms) ---
# OUTBOUND_URL_ALLOWED_HOSTS=["127.0.0.1","localhost"]
# NODE_OPTIONS=--dns-result-order=ipv4first
